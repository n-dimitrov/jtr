# Copy to .env and fill in. jtr will also prompt for missing values.
# Server/DC: include the context path. Cloud: https://<tenant>.atlassian.net
JTR_BASE_URL=https://tracker.example.com/jira
# The secret: a Bearer PAT on Server/DC, an API token on Cloud.
JTR_PAT=
# Cloud only: the Atlassian account email paired with the API token above.
JTR_EMAIL=
# Default project key (e.g. PROJ). Leave blank to query across all projects.
JTR_PROJECT=
# server | cloud | auto. Blank/auto detects from the base URL; set it only
# when the hostname misleads (vanity domain, or self-hosted on a Cloud-ish name).
JTR_DEPLOYMENT=
# Escape hatch: force REST v2 or v3. Normally unset — v3 exists on Cloud only,
# and its only real difference is ADF comment bodies, which jtr doesn't use.
JTR_API_VERSION=
